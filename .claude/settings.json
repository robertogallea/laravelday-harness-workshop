{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.local)",
      "Read(./.env.testing)",
      "Read(./.env.production)",
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan migrate:refresh*)",
      "Bash(php artisan migrate:reset*)",
      "Bash(php artisan migrate:rollback*)",
      "Bash(php artisan db:wipe*)",
      "Edit(./.harness/bin/**)",
      "Edit(./.harness/lib/**)",
      "Edit(./.harness/rules/**)",
      "Edit(./.harness/config.php)",
      "Edit(./.claude/**)",
      "Edit(./.codex/**)",
      "Edit(./.agents/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "php", "args": ["${CLAUDE_PROJECT_DIR}/.harness/bin/session-start", "--agent=claude"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Read|Grep|Glob|Edit|MultiEdit|Write|NotebookEdit)$",
        "hooks": [
          { "type": "command", "command": "php", "args": ["${CLAUDE_PROJECT_DIR}/.harness/bin/pre-tool", "--agent=claude"], "timeout": 10, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write|NotebookEdit)$",
        "hooks": [
          { "type": "command", "command": "php", "args": ["${CLAUDE_PROJECT_DIR}/.harness/bin/post-edit", "--agent=claude"], "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "php", "args": ["${CLAUDE_PROJECT_DIR}/.harness/bin/stop", "--agent=claude"], "timeout": 600 }
        ]
      }
    ]
  }
}
