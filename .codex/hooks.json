{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "php \"$(git rev-parse --show-toplevel)/.harness/bin/session-start\" --agent=codex", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          { "type": "command", "command": "php \"$(git rev-parse --show-toplevel)/.harness/bin/pre-tool\" --agent=codex", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "php \"$(git rev-parse --show-toplevel)/.harness/bin/post-edit\" --agent=codex", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "php \"$(git rev-parse --show-toplevel)/.harness/bin/stop\" --agent=codex", "timeout": 600 }
        ]
      }
    ]
  }
}
