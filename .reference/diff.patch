+<?php
+
+namespace App\Http\Requests;
+
+use Illuminate\Foundation\Http\FormRequest;
+use Illuminate\Support\Facades\Gate;
+
+/**
+ * Shape of a partial refund request. The refundable balance is checked by the Action
+ * (RefundOrderPartially).
+ */
+class StorePartialRefundRequest extends FormRequest
+{
+    /**
+     * OrderPolicy::refund, before validation (REFUND-INV-1): role finance/admin,
+     * order paid or partially_refunded.
+     */
+    public function authorize(): bool
+    {
+        Gate::authorize('refund', $this->route('order'));
+
+        return true;
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    public function rules(): array
+    {
+        return [
+            'amount' => ['required', 'integer', 'min:1'],
+            'reason' => ['required', 'string', 'max:255'],
+        ];
+    }
+}
diff --git a/app/Models/Order.php b/app/Models/Order.php
index 7700d32..d818f7e 100644
--- a/app/Models/Order.php
+++ b/app/Models/Order.php
@@ -48,4 +48,20 @@ public function refunds(): HasMany
     {
         return $this->hasMany(Refund::class);
     }
+
+    /**
+     * Sum of the refunds already issued, in cents (refunds.amount is in euros: C3).
+     */
+    public function refundedCents(): int
+    {
+        return $this->refunds()->get()->sum(fn (Refund $refund) => $refund->amountInCents());
+    }
+
+    /**
+     * Saldo rimborsabile: what can still be refunded, in cents.
+     */
+    public function refundableCents(): int
+    {
+        return max(0, $this->amount - $this->refundedCents());
+    }
 }
