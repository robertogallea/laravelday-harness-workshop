@@ -0,0 +1,29 @@
+<?php
+
+namespace App\Http\Controllers\Admin;
+
+use App\Actions\Refunds\RefundOrderPartially;
+use App\Http\Controllers\Controller;
+use App\Models\Order;
+use DomainException;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+
+class OrderPartialRefundController extends Controller
+{
+    public function store(Order $order, Request $request, RefundOrderPartially $refund): RedirectResponse
+    {
+        $data = $request->validate([
+            'amount' => ['required', 'integer', 'min:1'],
+            'reason' => ['required', 'string', 'max:255'],
+        ]);
+
+        try {
+            $refund->handle($order, $request->user(), $data['amount'], $data['reason'], $request->header('Idempotency-Key'));
+        } catch (DomainException $e) {
+            return back()->withErrors(['amount' => $e->getMessage()]);
+        }
+
+        return back()->with('status', 'Rimborso parziale registrato.');
+    }
+}
