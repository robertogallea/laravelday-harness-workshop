+<?php
+
+namespace App\Actions\Refunds;
+
+use App\Actions\Audit\RecordAuditEntry;
+use App\Enums\OrderStatus;
+use App\Events\OrderRefunded;
+use App\Models\Order;
+use App\Models\Refund;
+use App\Models\User;
+use App\Payments\PaymentGateway;
+use DomainException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+/**
+ * Rimborso parziale: gateway con chiave di idempotenza del client, poi scritture atomiche,
+ * poi notifica dopo il commit.
+ */
+final class RefundOrderPartially
+{
+    public function __construct(private PaymentGateway $gateway, private RecordAuditEntry $audit) {}
+
+    public function handle(Order $order, User $actor, int $amountCents, string $reason, string $idempotencyKey): Refund
+    {
+        Gate::forUser($actor)->authorize('refund', $order);
+
+        if ($existing = Refund::where('idempotency_key', $idempotencyKey)->first()) {
+            if ($existing->order_id !== $order->id) {
+                throw new DomainException('Idempotency key already used for another order.');
+            }
+
+            return $existing;
+        }
+
+        $refunded = (int) round($order->refunds()->sum('amount') * 100);
+        if ($amountCents <= 0 || $refunded + $amountCents > $order->amount) {
+            throw new DomainException('The refund exceeds the amount left on the order.');
+        }
+
+        $result = $this->gateway->refund($order->gateway_charge_id, $amountCents, "partial-refund-{$order->id}-{$idempotencyKey}");
+
+        $refund = DB::transaction(function () use ($order, $actor, $amountCents, $reason, $idempotencyKey, $result, $refunded) {
+            $refund = $order->refunds()->create([
+                'amount' => $amountCents / 100,
+                'gateway_refund_id' => $result->id,
+                'refunded_by' => $actor->id,
+                'reason' => $reason,
+                'idempotency_key' => $idempotencyKey,
+            ]);
+
+            $order->update([
+                'status' => $refunded + $amountCents === $order->amount ? OrderStatus::Refunded : OrderStatus::PartiallyRefunded,
+            ]);
+
+            $this->audit->handle($actor, 'order.refunded_partially', $order, [
+                'refund_id' => $refund->id,
+                'amount_cents' => $amountCents,
+                'reason' => $reason,
+                'idempotency_key' => $idempotencyKey,
+                'gateway_refund_id' => $result->id,
+            ]);
+
+            return $refund;
+        });
+
+        event(new OrderRefunded($order, $refund));
+
+        return $refund;
+    }
+}
