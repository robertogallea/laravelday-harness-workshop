#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES — author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────
#
# Porting dell'harness sul TUO progetto: fasi 0–4 di takeaway/scheda-porting.md.
#
#   cd <il tuo progetto Laravel>
#   bash <repo del workshop>/takeaway/bin/porting
#
# Linux, macOS (bash 3.2) e Windows (Git Bash, che arriva con Git for Windows, oppure WSL).
# Il wizard fa i collegamenti: branch, file nel posto giusto, @contract, group dei test,
# harness:check, commit, verify-port. Il contenuto lo scrivi tu: il fallimento, la scelta del
# pezzo, Conflicts e Pitfalls, le invarianti, il corpo del test, la review.
# Le modifiche ai file le fa PHP (c'è sempre, è un progetto Laravel): niente sed, che cambia fra
# Linux e macOS. Lo stato sta in .git/porting-wizard.env: interrompi con Ctrl-C e rilancia, le
# risposte date tornano come default. Il .env del progetto non viene né letto né scritto.
#
# Script del workshop "Costruire un harness per coding agent affidabili in Laravel". Licenza MIT.

TOTAL_STAGES=9

# Git Bash su Windows riscrive gli argomenti che sembrano path POSIX prima di passarli a php.exe:
# una risposta che comincia con "/" (una rotta, per esempio) finirebbe nel piano come C:/Program Files/Git/….
# Quindi niente conversione, e W in forma nativa (pwd -W: C:/…; su Linux e macOS pwd -W fallisce e vale pwd).
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
W="${PORTING_W:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && { pwd -W 2>/dev/null || pwd; })}"
KIT="$W/takeaway/kit"
BRANCH="harness/porting"
PLAN="docs/harness-porting.md"
ENV_FILE="/dev/null/nessuno-stato-prima-di-git"   # mai il .env del progetto: si imposta dopo git

die() { printf '  %s✗ %s%s\n' "$RED" "$1" "$RESET" >&2; exit 1; }
ok()  { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }

[[ -d "$KIT" && -f "$W/takeaway/bin/verify-port" ]] \
  || die "Non trovo il kit in $W/takeaway: lancia lo script dal repo del workshop (bash <workshop>/takeaway/bin/porting)."
[[ -f artisan && -f composer.json ]] \
  || die "Qui non c'è un progetto Laravel (manca artisan o composer.json): lancia il wizard dalla root del TUO progetto."
command -v php >/dev/null 2>&1 || die "php non è nel PATH."
command -v git >/dev/null 2>&1 || die "git non è nel PATH."
php -r 'exit(PHP_VERSION_ID >= 70300 ? 0 : 1);' || die "Serve PHP 7.3 o successivo nel PATH (verify-port vuole 8.1)."

# ── helper ──────────────────────────────────────────────────────────────────

# H: le modifiche ai file, in PHP. Scritto dentro .git/, quindi mai nel diff.
H=""
write_helper() {
  H="$GITDIR/porting-wizard.php"
  cat > "$H" <<'PHP'
<?php
// Helper del wizard di porting: modifiche ai file, identiche su Linux, macOS e Windows. PHP 7.3+.
$cmd = isset($argv[1]) ? $argv[1] : '';
$a = array_slice($argv, 2);

function fail($m) { fwrite(STDERR, $m . "\n"); exit(2); }
function has($h, $n) { return strpos($h, $n) !== false; }
function starts($h, $n) { return strncmp($h, $n, strlen($n)) === 0; }
function load($f) {
    $c = @file_get_contents($f);
    if ($c === false) { fail("non riesco a leggere $f"); }
    $eol = has($c, "\r\n") ? "\r\n" : "\n";
    return [str_replace("\r\n", "\n", $c), $eol];
}
function save($f, $c, $eol = "\n") {
    $d = dirname($f);
    if ($d !== '' && !is_dir($d)) { mkdir($d, 0777, true); }
    file_put_contents($f, $eol === "\n" ? $c : str_replace("\n", $eol, $c));
}
function nocomments($s) { return preg_replace('/<!--.*?-->/s', '', $s); }
function esc($v) { return str_replace(['|', "\n", "\r"], ['\|', ' ', ''], trim($v)); }
/** [inizio, fine) della sezione "## $name": dall'intestazione alla prossima # o ##. */
function section($lines, $name) {
    $start = null;
    foreach ($lines as $i => $l) {
        if ($start === null) {
            if (preg_match('/^##\s+' . preg_quote($name, '/') . '\b/', $l)) { $start = $i; }
        } elseif (preg_match('/^#{1,2}\s/', $l) || starts($l, '=== ')) {
            return [$start, $i];
        }
    }
    return $start === null ? null : [$start, count($lines)];
}
function cells($line) {
    $p = preg_split('/(?<!\\\\)\|/', trim($line));
    array_shift($p); array_pop($p);
    return array_map('trim', $p);
}
function rowline($cells) { return '| ' . implode(' | ', $cells) . ' |'; }
function is_sep($line) { return (bool) preg_match('/^\|[\s:|-]+\|$/', trim($line)); }
function key_of($cell) { return trim($cell, " *`"); }
function lock_version($pkg) {
    $j = is_file('composer.lock') ? json_decode((string) file_get_contents('composer.lock'), true) : null;
    foreach (['packages', 'packages-dev'] as $k) {
        foreach ((isset($j[$k]) ? $j[$k] : []) as $p) {
            if ($p['name'] === $pkg) { return ltrim($p['version'], 'v'); }
        }
    }
    return '';
}
function json_load($f) {
    if (!is_file($f)) { return new stdClass(); }
    $j = json_decode((string) file_get_contents($f));
    if (!is_object($j)) { fail("$f non è un JSON valido: correggilo a mano, poi rilancia"); }
    return $j;
}
function json_save($f, $j) {
    save($f, json_encode($j, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
}
/** La posizione della ] o } che chiude quella aperta in $open (le stringhe JSON non contano). */
function match_close($s, $open) {
    $depth = 0; $in = false; $n = strlen($s);
    for ($i = $open; $i < $n; $i++) {
        $ch = $s[$i];
        if ($in) { if ($ch === '\\') { $i++; } elseif ($ch === '"') { $in = false; } continue; }
        if ($ch === '"') { $in = true; continue; }
        if ($ch === '[' || $ch === '{') { $depth++; }
        elseif ($ch === ']' || $ch === '}') { $depth--; if ($depth === 0) { return $i; } }
    }
    return null;
}
function fqcn($path) {
    return starts($path, 'app/') ? 'App\\' . str_replace('/', '\\', substr($path, 4, -4)) : $path;
}
function sections_missing($md) {
    $l = explode("\n", nocomments($md));
    $out = [];
    foreach (['Topology', 'Commands', 'Environment', 'Pitfalls', 'Conflicts'] as $s) {
        if (section($l, $s) === null) { $out[] = $s; }
    }
    return $out;
}

switch ($cmd) {

case 'detect': // stampa KEY=VALUE
    $fw = lock_version('laravel/framework');
    $pu = lock_version('phpunit/phpunit');
    $agents = is_file('AGENTS.md') ? (string) file_get_contents('AGENTS.md') : '';
    $claude = is_file('CLAUDE.md') ? (string) file_get_contents('CLAUDE.md') : '';
    $boost = has($agents, '<laravel-boost-guidelines>') || has($claude, '<laravel-boost-guidelines>');
    echo 'LARAVEL=', $fw, "\n";
    echo 'LARAVEL_MAJOR=', (int) $fw, "\n";
    echo 'TESTER=', is_file('vendor/bin/pest') || lock_version('pestphp/pest') !== '' ? 'pest' : ($pu !== '' ? 'phpunit' : 'none'), "\n";
    echo 'PHPUNIT_MAJOR=', (int) $pu, "\n";
    echo 'HAS_PINT=', is_file('vendor/bin/pint') || lock_version('laravel/pint') !== '' ? 1 : 0, "\n";
    echo 'HAS_PHPSTAN=', is_file('vendor/bin/phpstan') || lock_version('phpstan/phpstan') !== '' ? 1 : 0, "\n";
    echo 'HAS_VENDOR=', is_dir('vendor') ? 1 : 0, "\n";
    echo 'BOOST=', $boost ? 1 : 0, "\n";
    echo 'BOOST_JSON=', is_file('boost.json') ? 1 : 0, "\n";
    echo 'HAS_AGENTS=', $agents !== '' ? 1 : 0, "\n";
    echo 'HAS_CLAUDE=', is_file('CLAUDE.md') ? 1 : 0, "\n";
    echo 'CLAUDE_IMPORTS=', preg_match('/^@AGENTS\.md\s*$/m', $claude) ? 1 : 0, "\n";
    echo 'PHP_OK_VERIFY=', PHP_VERSION_ID >= 80100 ? 1 : 0, "\n";
    break;

case 'cell': // cell FILE SECTION KEY V2 [V3 …]: imposta le colonne 2.. della riga KEY
    list($f, $sec, $key) = array_slice($a, 0, 3);
    $vals = array_slice($a, 3);
    list($c, $eol) = load($f);
    $l = explode("\n", $c);
    $r = section($l, $sec) ?: fail("$f: manca la sezione ## $sec");
    $hit = false;
    for ($i = $r[0] + 1; $i < $r[1]; $i++) {
        if (!starts(trim($l[$i]), '|') || is_sep($l[$i])) { continue; }
        $cs = cells($l[$i]);
        if (count($cs) < 2 || !starts(key_of($cs[0]), $key)) { continue; }
        foreach ($vals as $k => $v) { $cs[$k + 1] = esc($v); }
        $l[$i] = rowline($cs);
        $hit = true;
        break;
    }
    $hit || fail("$f: nella sezione $sec non c'è la riga «$key»");
    save($f, implode("\n", $l), $eol);
    break;

case 'body': // body FILE SECTION TEXT: sostituisce il corpo della sezione (tiene il commento guida)
    list($f, $sec, $text) = $a;
    list($c, $eol) = load($f);
    $l = explode("\n", $c);
    $r = section($l, $sec) ?: fail("$f: manca la sezione ## $sec");
    $body = implode("\n", array_slice($l, $r[0] + 1, $r[1] - $r[0] - 1));
    $keep = preg_match('/^\s*<!--.*?-->/s', $body, $m) ? trim($m[0]) . "\n" : '';
    $new = array_merge([$l[$r[0]], ''], explode("\n", $keep . rtrim($text)), ['']);
    array_splice($l, $r[0], $r[1] - $r[0], $new);
    save($f, implode("\n", $l), $eol);
    break;

case 'checkline': // checkline FILE PREFIX VALUE: "- [ ] PREFIX VALUE"
    list($f, $prefix, $v) = $a;
    list($c, $eol) = load($f);
    $l = explode("\n", $c);
    $hit = false;
    foreach ($l as $i => $line) {
        if (preg_match('/^(\s*- \[[ xX]\] )' . preg_quote($prefix, '/') . '/', $line, $m)) {
            $l[$i] = $m[1] . $prefix . ($v === '' ? '' : ' ' . trim($v));
            $hit = true;
            break;
        }
    }
    $hit || fail("$f: non trovo la voce «$prefix»");
    save($f, implode("\n", $l), $eol);
    break;

case 'kit-agents': // kit-agents KIT DEST guideline|agents KEEP_INDEX TESTER HAS_PINT HAS_PHPSTAN LARAVEL_MAJOR
    list($kit, $dest, $mode, $keepIndex, $tester, $pint, $stan, $major) = $a;
    list($c) = load($kit);
    if ($mode === 'guideline') { $c = substr($c, strpos($c, '## Topology')); }
    $l = explode("\n", $c);
    // Topology: via le righe che puntano a file che nel progetto non ci sono.
    $r = section($l, 'Topology');
    for ($i = $r[1] - 1; $i > $r[0]; $i--) {
        if (!preg_match('/^- `([^`]+)`/', $l[$i], $m) || has($m[1], '…')) { continue; }
        $p = rtrim($m[1], '/');
        if (file_exists($p) || ($keepIndex === '1' && $p === 'docs/contracts/INDEX.md')) { continue; }
        array_splice($l, $i, 1);
    }
    // Commands: i comandi che ci sono davvero in questo progetto.
    $cmds = [];
    if ($tester === 'pest') {
        $cmds[] = "- Test: `vendor/bin/pest`; su un'invariante sola: `vendor/bin/pest --group=<ID>` (un `--group` per ID).";
    } elseif ($tester === 'phpunit') {
        $cmds[] = "- Test: `vendor/bin/phpunit`; su un'invariante sola: `vendor/bin/phpunit --group <ID>` (un `--group` per ID).";
    }
    $cmds[] = $pint === '1' ? '- Stile: `vendor/bin/pint --dirty`.' : '- Pint non è installato.';
    $cmds[] = $stan === '1' ? '- Analisi statica: `vendor/bin/phpstan analyse`.' : '- PHPStan non è installato.';
    $cmds[] = (int) $major >= 9
        ? '- Discovery: `php artisan about`, `php artisan route:list --path=…`, `php artisan model:show <Model>`, `php artisan db:table <tabella>`.'
        : '- Discovery: `php artisan route:list`; per modelli e schema, le migrazioni e i model.';
    foreach ($l as $i => $line) {
        if (starts($line, '- Test mirati su un')) { array_splice($l, $i, 1, $cmds); break; }
    }
    if (file_exists($dest)) { fail("$dest c'è già: non lo sovrascrivo"); }
    save($dest, implode("\n", $l));
    break;

case 'agents-merge': // agents-merge KIT AGENTS: aggiunge in fondo le sezioni che mancano
    list($kit, $f) = $a;
    list($k) = load($kit);
    list($c, $eol) = load($f);
    $kl = explode("\n", $k);
    $add = [];
    foreach (sections_missing($c) as $s) {
        $r = section($kl, $s);
        $add[] = implode("\n", array_slice($kl, $r[0], $r[1] - $r[0]));
        echo $s, "\n";
    }
    if ($add) { save($f, rtrim($c) . "\n\n" . rtrim(implode("\n", $add)) . "\n", $eol); }
    break;

case 'check-agents': // check-agents FILE: exit 0 se le 5 sezioni ci sono, Conflicts ha righe, Pitfalls non è vuota
    list($c) = load($a[0]);
    $bad = [];
    $miss = sections_missing($c);
    if ($miss) { $bad[] = 'mancano le sezioni: ' . implode(', ', $miss); }
    $l = explode("\n", nocomments($c));
    if ($r = section($l, 'Conflicts')) {
        $n = 0; $header = true;
        for ($i = $r[0] + 1; $i < $r[1]; $i++) {
            $t = trim($l[$i]);
            if (!starts($t, '|')) { $header = true; continue; }
            if (is_sep($t)) { $header = false; continue; }
            if (!$header && count(array_filter(cells($t), 'strlen')) >= 2) { $n++; }
        }
        if ($n === 0) { $bad[] = 'Conflicts: nessuna riga nella tabella (da una a tre, a partire dal fallimento)'; }
    }
    foreach (['Commands', 'Pitfalls'] as $s) {
        if (($r = section($l, $s)) && trim(implode("\n", array_slice($l, $r[0] + 1, $r[1] - $r[0] - 1))) === '') {
            $bad[] = "$s: vuota";
        }
    }
    foreach ($bad as $b) { echo $b, "\n"; }
    exit($bad ? 1 : 0);

case 'contains': // contains FILE TEXT
    exit(is_file($a[0]) && has((string) file_get_contents($a[0]), $a[1]) ? 0 : 1);

case 'claude-import': // claude-import FILE: mette @AGENTS.md in cima
    list($c, $eol) = load($a[0]);
    save($a[0], "@AGENTS.md\n\n" . $c, $eol);
    break;

case 'contract': // contract KIT DEST TITLE DESC SLUG CLASSES PREFIX RULE1 [RULE2 RULE3]
    list($kit, $dest, $title, $desc, $slug, $classes, $prefix) = array_slice($a, 0, 7);
    $rules = array_values(array_filter(array_slice($a, 7), 'strlen'));
    $new = !is_file($dest);
    list($c, $eol) = $new ? load($kit) : load($dest);
    $l = explode("\n", $c);
    $cls = implode(', ', array_map(function ($p) { return '`' . fqcn($p) . '`'; }, preg_split('/\s+/', trim($classes))));
    foreach ($l as $i => $line) {
        if ($new && $i === 0) { $l[$i] = '# ' . $title; }
        if ($new && starts($line, '<!-- Una frase') && $desc !== '') { $l[$i] = $desc; }
        if (preg_match('/^Class[ei]:/', $line)) { $l[$i] = "Classi: $cls (docblock: `@contract docs/contracts/$slug.md`)"; }
    }
    $r = section($l, 'Invarianti') ?: fail("$dest: manca la sezione ## Invarianti");
    $sep = null;
    for ($i = $r[0] + 1; $i < $r[1]; $i++) { if (is_sep($l[$i])) { $sep = $i; break; } }
    $sep !== null || fail("$dest: nella sezione Invarianti manca la tabella");
    $end = $sep + 1;
    while ($end < $r[1] && starts(trim($l[$end]), '|')) { $end++; }
    $rows = [];
    foreach ($rules as $n => $rule) {
        $id = $prefix . '-INV-' . ($n + 1);
        $rows[] = rowline([$id, esc($rule), $id]);
    }
    array_splice($l, $sep + 1, $end - $sep - 1, $rows);
    save($dest, implode("\n", $l), $eol);
    echo $new ? "creato\n" : "aggiornato\n";
    break;

case 'index': // index KIT DEST TITLE SLUG CLASSES IDS
    list($kit, $dest, $title, $slug, $classes, $ids) = $a;
    list($c, $eol) = is_file($dest) ? load($dest) : load($kit);
    $l = explode("\n", $c);
    $cls = implode(', ', array_map(function ($p) { return '`' . fqcn($p) . '`'; }, preg_split('/\s+/', trim($classes))));
    $row = rowline([esc($title), "[$slug.md]($slug.md)", $cls, $ids]);
    $sep = null; $hit = false;
    foreach ($l as $i => $line) {
        if (is_sep($line)) { $sep = $i; continue; }
        if ($sep === null || !starts(trim($line), '|')) { continue; }
        $cs = cells($line);
        if (has($cs[0], '<!--')) { $l[$i] = null; continue; }        // la riga d'esempio del kit
        if (isset($cs[1]) && (has($cs[1], "($slug.md)") || $cs[1] === "$slug.md")) { $l[$i] = $row; $hit = true; }
    }
    $sep !== null || fail("$dest: manca la tabella");
    $l = array_values(array_filter($l, function ($x) { return $x !== null; }));
    if (!$hit) {
        $i = array_search(true, array_map('is_sep', $l), true) + 1;
        while ($i < count($l) && starts(trim($l[$i]), '|')) { $i++; }
        array_splice($l, $i, 0, [$row]);
    }
    save($dest, implode("\n", $l), $eol);
    break;

case 'tag': // tag FILE SLUG: @contract nel docblock della classe
    list($f, $slug) = $a;
    $tag = "@contract docs/contracts/$slug.md";
    list($c, $eol) = load($f);
    if (preg_match('/^\s*\*\s*' . preg_quote($tag, '/') . '\s*$/m', $c)) { echo "presente\n"; break; }
    $l = explode("\n", $c);
    foreach ($l as $i => $line) {   // @contract('…') o @contract(…: lo riscrivo nel formato PHPDoc
        if (preg_match('/^(\s*\*\s*)@contract\s*\(/', $line, $m) && has($line, $slug)) {
            $l[$i] = $m[1] . $tag;
            save($f, implode("\n", $l), $eol);
            echo "corretto\n";
            exit(0);
        }
    }
    $cl = null;
    foreach ($l as $i => $line) {
        if (preg_match('/^\s*((final|abstract|readonly)\s+)*(class|interface|trait|enum)\s+\w+/', $line)) { $cl = $i; break; }
    }
    $cl !== null || fail("$f: non trovo la dichiarazione della classe");
    $j = $cl - 1;                                   // risale oltre gli attributi #[…], anche su più righe
    while ($j >= 0) {
        $t = trim($l[$j]);
        if (starts($t, '#[')) { $j--; continue; }
        if ($t !== '' && !starts($t, '*') && !starts($t, '/') && preg_match('/\]\s*$/', $t)) {
            $k = $j;
            while ($k >= 0 && !starts(trim($l[$k]), '#[')) { $k--; }
            if ($k < 0) { break; }
            $j = $k - 1;
            continue;
        }
        break;
    }
    if ($j >= 0 && preg_match('/^\s*\/\*\*.*\*\/\s*$/', $l[$j])) {      // docblock su una riga
        $inner = trim(preg_replace('/^\s*\/\*\*|\*\/\s*$/', '', $l[$j]));
        array_splice($l, $j, 1, array_merge(['/**'], $inner !== '' ? [' * ' . $inner, ' *'] : [], [' * ' . $tag, ' */']));
    } elseif ($j >= 0 && preg_match('/^\s*\*\/\s*$/', $l[$j])) {        // docblock: prima di */
        $prev = trim($l[$j - 1]);
        $ins = ($prev === '*' || starts($prev, '/**') || preg_match('/^\*\s*@/', $prev)) ? [' * ' . $tag] : [' *', ' * ' . $tag];
        array_splice($l, $j, 0, $ins);
    } else {
        array_splice($l, $j + 1, 0, ['/**', ' * ' . $tag, ' */']);
    }
    save($f, implode("\n", $l), $eol);
    echo "aggiunto\n";
    break;

case 'test': // test TESTER PHPUNIT_MAJOR FILE ID RULE
    list($tester, $major, $f, $id, $rule) = $a;
    $marker = "Da scrivere: $id";
    $exists = is_file($f);
    if ($exists && preg_match('/[\'"]' . preg_quote($id, '/') . '[\'"]|@group\s+' . preg_quote($id, '/') . '\b/', (string) file_get_contents($f))) {
        echo "presente\n"; break;
    }
    $desc = str_replace("'", "\\'", mb_substr("$id: $rule", 0, 100));
    if ($tester === 'pest') {
        $block = "// $id: " . trim($rule) . "\nit('$desc', function () {\n    throw new LogicException('$marker');\n})->group('$id');\n";
        if ($exists) {
            list($c, $eol) = load($f);
            save($f, rtrim($c) . "\n\n" . $block, $eol);
            echo "aggiunto\n";
        } else {
            save($f, "<?php\n\n" . $block);
            echo "creato\n";
        }
        break;
    }
    $exists && fail("$f c'è già: con PHPUnit aggiungi a mano un metodo con il group $id, oppure scegli un file nuovo");
    $ns = 'Tests\\' . str_replace('/', '\\', trim(substr(dirname($f), strlen('tests')), '/'));
    $ns = rtrim($ns, '\\');
    $class = basename($f, '.php');
    $method = 'test_' . strtolower(str_replace('-', '_', $id));
    $attr = (int) $major >= 10;
    $src = "<?php\n\nnamespace $ns;\n\n" . ($attr ? "use PHPUnit\\Framework\\Attributes\\Group;\n" : '') . "use Tests\\TestCase;\n\n"
        . "class $class extends TestCase\n{\n"
        . "    /**\n     * $id: " . trim($rule) . "\n" . ($attr ? '' : "     *\n     * @group $id\n") . "     */\n"
        . ($attr ? "    #[Group('$id')]\n" : '')
        . "    public function $method(): void\n    {\n        \$this->fail('$marker');\n    }\n}\n";
    save($f, $src);
    echo "creato\n";
    break;

case 'deny': // deny FILE RULE…: unisce le regole in permissions.deny
    $f = array_shift($a);
    $j = json_load($f);
    if (!isset($j->permissions) || !is_object($j->permissions)) { $j->permissions = new stdClass(); }
    $d = isset($j->permissions->deny) && is_array($j->permissions->deny) ? $j->permissions->deny : [];
    $j->permissions->deny = array_values(array_unique(array_merge($d, $a)));
    json_save($f, $j);
    echo count($j->permissions->deny) - count($d), "\n";
    break;

case 'script': // script FILE NAME CMD…: composer scripts.NAME, toccando solo quelle righe
    $f = array_shift($a);
    $name = array_shift($a);
    list($c, $eol) = load($f);
    $j = json_decode($c);
    if (!is_object($j)) { fail("$f non è un JSON valido: correggilo a mano, poi rilancia"); }
    $old = isset($j->scripts->{$name}) ? $j->scripts->{$name} : null;
    if ($old === $a) { echo "invariato\n"; break; }
    $ind = preg_match('/^( +|\t)"/m', $c, $m) ? $m[1] : '    ';
    $arr = "[\n" . implode(",\n", array_map(function ($x) use ($ind) {
        return $ind . $ind . $ind . json_encode($x, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    }, $a)) . "\n" . $ind . $ind . ']';
    $key = json_encode($name, JSON_UNESCAPED_SLASHES);
    $new = null;
    if (is_array($old) && preg_match('/' . preg_quote($key, '/') . '\s*:\s*\[/', $c, $m, PREG_OFFSET_CAPTURE)) {
        $open = $m[0][1] + strlen($m[0][0]) - 1;
        $close = match_close($c, $open);
        if ($close !== null) { $new = substr($c, 0, $open) . $arr . substr($c, $close + 1); }
    } elseif ($old === null && preg_match('/"scripts"\s*:\s*\{/', $c, $m, PREG_OFFSET_CAPTURE)) {
        $open = $m[0][1] + strlen($m[0][0]) - 1;
        $close = match_close($c, $open);
        if ($close !== null) {
            $before = rtrim(substr($c, 0, $close));
            $comma = substr($before, -1) === '{' ? '' : ',';
            $new = $before . $comma . "\n" . $ind . $ind . $key . ': ' . $arr . "\n" . $ind . substr($c, $close);
        }
    } elseif ($old === null && !isset($j->scripts)) {
        $close = strrpos($c, '}');
        $before = rtrim(substr($c, 0, $close));
        $new = $before . ",\n" . $ind . '"scripts": {' . "\n" . $ind . $ind . $key . ': ' . $arr . "\n" . $ind . "}\n" . substr($c, $close);
    }
    $check = $new === null ? null : json_decode($new);
    if (!is_object($check) || !isset($check->scripts->{$name}) || $check->scripts->{$name} !== $a) {
        $j->scripts = isset($j->scripts) && is_object($j->scripts) ? $j->scripts : new stdClass();
        $j->scripts->{$name} = $a;            // struttura insolita: riscrivo tutto il file
        json_save($f, $j);
        echo $old === null ? "aggiunto (composer.json riformattato)\n" : "sostituito (composer.json riformattato)\n";
        break;
    }
    save($f, $new, $eol);
    echo $old === null ? "aggiunto\n" : "sostituito\n";
    break;

case 'commands-line': // commands-line FILE LINE: la riga "Prima di dire fatto" in Commands
    list($f, $text) = $a;
    list($c, $eol) = load($f);
    $l = explode("\n", $c);
    $r = section($l, 'Commands') ?: fail("$f: manca la sezione ## Commands");
    $last = $r[0];
    for ($i = $r[0] + 1; $i < $r[1]; $i++) {
        if (preg_match('/^- Prima di dire ["“]fatto["”]/u', $l[$i])) { $l[$i] = $text; save($f, implode("\n", $l), $eol); exit(0); }
        if (starts($l[$i], '- ')) { $last = $i; }
    }
    array_splice($l, $last + 1, 0, [$text]);
    save($f, implode("\n", $l), $eol);
    break;

case 'boost-agents': // boost-agents FILE AGENTE…: "agents" in boost.json, se manca
    $f = array_shift($a);
    $j = json_load($f);
    if (!empty($j->agents)) { echo "presenti\n"; break; }
    $j->agents = $a;
    json_save($f, $j);
    echo "aggiunti\n";
    break;

case 'date': // date GIORNI
    echo date('Y-m-d', strtotime('+' . (int) $a[0] . ' days')), "\n";
    break;

default:
    fail("comando sconosciuto: $cmd");
}
PHP
}

hp() { php "$H" "$@"; }

# Lo stato del wizard vive in .git/, il .env del progetto resta intatto.
use_git_state() {
  GITDIR="$(git rev-parse --git-dir)"
  ENV_FILE="$GITDIR/porting-wizard.env"
  write_helper
}

# get KEY — il valore salvato (vuoto se non c'è).
get() { _existing "$1" 2>/dev/null || true; }

# ask_def KEY "Prompt" DEFAULT — come ask, con un default proposto alla prima esecuzione.
ask_def() {
  local key="$1" prompt="$2" def="$3" cur
  cur="$(get "$key")"
  if [[ -z "$cur" && -n "$def" ]]; then
    printf '  %s%s%s %s[Invio = %s]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$def" "$RESET"
    local input=""; read -r input || true
    input="${input%$'\r'}"
    printf -v "$key" '%s' "${input:-$def}"
  else
    ask "$key" "$prompt"
    printf -v "$key" '%s' "${!key%$'\r'}"
  fi
}

# ask_req KEY "Prompt" [REGEX] [MESSAGGIO] — insiste finché la risposta non è valida.
ask_req() {
  local key="$1" prompt="$2" re="${3:-.}" msg="${4:-Serve una risposta.}"
  while :; do
    ask "$key" "$prompt"
    printf -v "$key" '%s' "${!key%$'\r'}"
    [[ "${!key}" =~ $re ]] && return 0
    warn "$msg"
    [[ -t 0 ]] || die "Nessuna risposta valida e nessun terminale da cui leggerne un'altra: lancia il wizard da un terminale."
  done
}

# edit FILE "cosa scrivere" — l'editor se c'è, altrimenti apri il file tu.
edit() {
  local f="$1"
  step "Apri ${BOLD}$f${RESET} e $2"
  if [[ -n "${VISUAL:-${EDITOR:-}}" ]] && confirm "Lo apro con ${VISUAL:-$EDITOR}?"; then
    ${VISUAL:-$EDITOR} "$f" || warn "l'editor è uscito con un errore: aprilo tu"
  fi
  pause "Salva il file, poi Invio."
}

# commit MSG PATH… — committa solo i path indicati che esistono.
commit() {
  local msg="$1" p; shift
  for p in "$@"; do
    if [[ -e "$p" ]] || git ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then git add -A -- "$p"; fi
  done
  if git diff --cached --quiet; then note "Niente di nuovo da committare."; return 0; fi
  git commit -q -m "$msg" && ok "commit $(git rev-parse --short HEAD): $msg"
}

# run CMD… — lancia, mostra le ultime righe, mette l'exit in RC.
RC=0
run() {
  local out
  printf '  %s$ %s%s\n' "$DIM" "$*" "$RESET"
  set +e; out="$("$@" 2>&1)"; RC=$?; set -e
  printf '%s\n' "$out" | tail -n 25 | sed 's/^/    /'
  LAST_OUT="$out"
}
LAST_OUT=""

tests() { # tests [ID] — la suite, o un solo group
  case "$TESTER" in
    pest)    if [[ -n "${1:-}" ]]; then run php vendor/bin/pest "--group=$1"; else run php vendor/bin/pest; fi ;;
    phpunit) if [[ -n "${1:-}" ]]; then run php vendor/bin/phpunit --group "$1"; else run php vendor/bin/phpunit; fi ;;
    *)       warn "Non trovo né Pest né PHPUnit in composer.lock."; RC=2 ;;
  esac
}

# skip_if_done N — su un nuovo giro, una tappa già fatta si può saltare.
skip_if_done() {
  [[ "$(get "DONE_$1")" == 1 ]] || return 1
  note "Questa tappa l'hai già fatta in un giro precedente."
  if confirm "La rifai?"; then return 1; fi
  return 0
}
done_stage() { write_env "DONE_$1" 1 >/dev/null; }

# suggested N — la tappa N (4, 5 o 6) è il pezzo scelto? Altrimenti si può saltare.
suggested() {
  case "$(get PIECE)" in
    1|2|7|8) [[ "$1" == 4 ]] ;;
    3)       [[ "$1" == 5 ]] ;;
    5|6)     [[ "$1" == 6 ]] ;;
    *)       return 0 ;;
  esac
}
optional_gate() {
  suggested "$1" && return 0
  note "Non è il passo del tuo pezzo: la scheda dice di dedicare il tempo a quello e saltare gli altri."
  confirm "Lo fai lo stesso?"
}

# Il file in cui vanno le sezioni di AGENTS.md: con Boost, .ai/guidelines/harness.md.
guide_file() { if [[ "$BOOST" == 1 ]]; then echo ".ai/guidelines/harness.md"; else echo "AGENTS.md"; fi; }

boost_regen() {
  local before=0
  hp contains AGENTS.md "## Skills Activation" && before=1
  if [[ ! -f boost.json ]]; then
    warn "AGENTS.md ha il formato di Boost, ma Boost non è configurato (manca boost.json): boost:update non lo rigenera."
    say "boost:install --guidelines crea boost.json con le sole linee guida e rigenera AGENTS.md e CLAUDE.md"
    say "con le tue sezioni in cima. Non installa skill né MCP. AGENTS.md cambia anche nel resto: guarda il diff."
    if ! confirm "Lancio php artisan boost:install --guidelines --no-interaction?"; then
      warn "Senza Boost configurato le tue sezioni non arrivano ad AGENTS.md: l'agente non le legge."
      return 1
    fi
    run php artisan boost:install --guidelines --no-interaction
    (( RC == 0 )) || { warn "boost:install è fallito: sistemalo, poi rilancia il wizard."; return 1; }
    hp contains AGENTS.md "## Conflicts" || { warn "AGENTS.md rigenerato, ma senza le tue sezioni: controlla .ai/guidelines/harness.md."; return 1; }
    # Boost 2.10: senza domande non salva "agents" in boost.json, e poi boost:update rifiuta di partire.
    [[ "$(hp boost-agents boost.json claude_code codex)" == aggiunti ]] \
      && note "boost.json: aggiunti gli agenti claude_code e codex, senza i quali boost:update non parte."
    ok "Boost configurato: le tue sezioni sono in cima ad AGENTS.md e CLAUDE.md"
    return 0
  fi
  run php artisan boost:update --no-discover --ignore-skills
  (( RC == 0 )) || { warn "boost:update è fallito: sistemalo, poi rilancia il wizard."; return 1; }
  hp contains AGENTS.md "## Conflicts" || { warn "AGENTS.md rigenerato, ma senza le tue sezioni: controlla .ai/guidelines/harness.md."; return 1; }
  local other
  other="$(git status --porcelain | sed 's/^...//' | grep -vE '^(AGENTS\.md|CLAUDE\.md|boost\.json|\.ai/|docs/|composer\.json)' || true)"
  [[ -z "$other" ]] || { warn "boost:update ha cambiato anche altri file, guardali prima del commit:"; printf '%s\n' "$other" | sed 's/^/      /'; }
  if (( before )) && ! hp contains AGENTS.md "## Skills Activation"; then
    warn "Boost ha tolto il paragrafo \"Skills Activation\": le skill restano, ma l'agente non è più invitato ad attivarle."
    note "Per riaverlo: php artisan boost:update --no-discover (senza --ignore-skills), poi guarda git diff."
  fi
  return 0
}

# ──────────────────────────────────────────────────────────────────────────

banner "Porting dell'harness sul tuo progetto (scheda-porting.md, fasi 0–4)"

# ── 1 ── fase 0: preparazione ───────────────────────────────────────────────
stage "Fase 0 · Preparazione"
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  warn "Questa cartella non è un repository git: il porting va su un branch, per farlo rivedere."
  confirm "Faccio git init e un primo commit con lo stato attuale?" || die "Senza git non posso creare il branch $BRANCH."
  git init -q
fi
if [[ -z "$(git config user.email || true)" ]]; then
  warn "git non sa chi sei: senza nome ed email non può committare."
  step "git config --global user.name \"Nome Cognome\"  e  git config --global user.email tu@esempio.it"
  pause "Fatto? Invio."
  [[ -n "$(git config user.email || true)" ]] || die "git config user.email è ancora vuoto."
fi
if ! git rev-parse --verify -q HEAD >/dev/null; then
  git add -A && git commit -q -m "Stato iniziale del progetto" && ok "primo commit: stato iniziale"
fi
use_git_state
while IFS='=' read -r k v; do printf -v "$k" '%s' "$v"; done < <(hp detect)

say "Laravel ${LARAVEL:-?} · test: $TESTER · Pint: $( ((HAS_PINT)) && echo sì || echo no) · PHPStan: $( ((HAS_PHPSTAN)) && echo sì || echo no) · Laravel Boost: $( ((BOOST)) && echo sì || echo no)"
say "Istruzioni che esistono già: $( ((HAS_AGENTS)) && echo -n 'AGENTS.md ')$( ((HAS_CLAUDE)) && echo -n 'CLAUDE.md')$( ((HAS_AGENTS || HAS_CLAUDE)) || echo nessuna)"
((HAS_VENDOR)) || warn "Manca vendor/: lancia composer install, o i test non partiranno."
((BOOST)) && note "Con Boost, AGENTS.md e CLAUDE.md sono generati: le tue sezioni andranno in .ai/guidelines/harness.md."
((BOOST && !BOOST_JSON)) && note "AGENTS.md ha il formato di Boost, ma manca boost.json (lo skeleton di Laravel 13 è così): Boost andrà configurato."
ask_req AGENT "Agente che userai: [c] Claude Code  [x] Codex  [e] entrambi" '^[cxeCXE]$' "Rispondi c, x oppure e."
write_env AGENT "$(printf '%s' "$AGENT" | tr 'CXE' 'cxe')"
AGENT="$(get AGENT)"

CUR="$(git symbolic-ref --short -q HEAD || echo '')"
if [[ "$CUR" != "$BRANCH" ]]; then
  write_env BASE "${CUR:-HEAD}"
  if [[ -n "$(git status --porcelain)" ]]; then
    warn "Ci sono modifiche non committate: finirebbero nella PR dell'harness, mescolate al porting."
    git status --short | head -n 15 | sed 's/^/      /'
    if confirm "Le committo su $CUR, prima di creare $BRANCH?"; then
      ask_def WIP_MSG "Messaggio del commit:" "Lavoro in corso prima del porting"
      git add -A && git commit -q -m "$WIP_MSG" && ok "commit su $CUR: $WIP_MSG"
    fi
  fi
  if git rev-parse --verify -q "refs/heads/$BRANCH" >/dev/null; then
    git checkout -q "$BRANCH" && ok "sei su $BRANCH (c'era già)"
  else
    git checkout -q -b "$BRANCH" && ok "creato il branch $BRANCH da ${CUR:-HEAD}"
  fi
else
  ok "sei già su $BRANCH"
  if [[ -z "$(get BASE)" ]]; then
    for b in main master develop; do
      if git rev-parse --verify -q "refs/heads/$b" >/dev/null; then write_env BASE "$b" >/dev/null; break; fi
    done
    [[ -n "$(get BASE)" ]] || { ask_req BASE "Da quale branch è partito $BRANCH?"; write_env BASE "$BASE" >/dev/null; }
  fi
fi
BASE="$(get BASE)"
if [[ -f "$PLAN" ]]; then ok "$PLAN c'è già"; else mkdir -p docs && cp "$KIT/$PLAN" "$PLAN" && ok "copiato $PLAN: fallimento, pezzo e piano vanno lì, nella PR"; fi
if [[ "$(get BASELINE)" == "" ]] && confirm "Lancio i test adesso, come punto di partenza? (con una suite lenta, di' no)"; then
  tests
  write_env BASELINE "$( ((RC == 0)) && echo verdi || echo rossi)"
  ((RC == 0)) || warn "La suite è già rossa prima del porting: annotalo, non è colpa dell'harness."
fi
pause "Invio per il fallimento."

# ── 2 ── fase 1: un fallimento reale ────────────────────────────────────────
stage "Fase 1 · Un fallimento reale (7')"
if ! skip_if_done 2; then
  say "Pensa all'ultima volta in cui un agente (o un collega nuovo) ha fatto qui qualcosa di"
  say "${BOLD}plausibile ma sbagliato${RESET}. Un caso solo."
  note "Non ti viene in mente? Provocane uno, in sola lettura ($( [[ "$AGENT" == x ]] && echo 'Codex: chiedigli di non modificare niente' || echo 'Claude Code: Shift+Tab fino alla modalità plan')):"
  note "  «Devo aggiungere <una piccola feature del tuo dominio>. Senza modificare nulla, dimmi: quali file"
  note "   toccheresti, dove si decide l'autorizzazione, come lo testeresti senza rete, e quali vincoli del"
  note "   progetto devo rispettare.» Dove l'agente indovina, cita il codice vicino invece della regola o"
  note "   dà per buona un'eccezione, lì c'è il tuo fallimento."
  say ""
  ask_req F_TASK   "Che task era?"
  ask_req F_DID    "Cosa ha fatto l'agente? (il comportamento, non il suo riassunto)"
  ask_req F_SHOULD "Cosa avrebbe dovuto fare, e dove era scritto? (se da nessuna parte, scrivilo)"
  ask_req F_CRIT   "Criterio violato (autorizzazione · transazioni · tracciabilità · idempotenza · test · altro):"
  ask_req F_COPIED "Da quale codice ha copiato? (anche «nessuno: il pattern generico X» è una risposta)"
  ask_req F_DAMAGE "Danno reale o evitato per un pelo?"
  for kv in "Che task era?:F_TASK" "Cosa ha fatto l'agente?:F_DID" "Cosa avrebbe dovuto fare:F_SHOULD" \
            "Quale criterio ha violato?:F_CRIT" "Da quale codice ha copiato?:F_COPIED" "Danno reale:F_DAMAGE"; do
    var="${kv##*:}"
    hp cell "$PLAN" "Il fallimento" "${kv%:*}" "${!var}"
    write_env "$var" "${!var}" >/dev/null
  done
  ok "tabella del fallimento compilata in $PLAN"
  done_stage 2
fi
pause "Invio per scegliere il pezzo."

# ── 3 ── fase 2: il pezzo più piccolo ───────────────────────────────────────
stage "Fase 2 · Il pezzo più piccolo (3')"
PIECES=(
  "ha seguito il codice vecchio invece della convenzione|una riga in AGENTS.md → Conflicts|LEG-2|L2"
  "non ha trovato dove si decide qualcosa (authz, config, test)|una riga in Topology o in Commands|LEG-1, DIS-1|L2"
  "ha violato una regola di business|un Behavioral Contract con 1–3 invarianti e un test per ID|CTX-3, VER-1|L2 · L5"
  "ha toccato file che non doveva|un Task Contract con must_not_change|CTX-5, VIN-3|L1"
  "ha letto segreti o lanciato comandi distruttivi|un deny nativo su Claude Code, il pre-hook su Codex|VIN-1, VIN-2|L3"
  "ha detto \"fatto\" senza prove|un comando \"fatto\" in Commands, poi lo stop hook|VER-2|L5"
  "ha perso il filo fra una sessione e l'altra|progress.md più un puntatore in AGENTS.md|CTX-6|L4"
  "ha ripetuto un errore già visto|una Lesson che produce un Pitfall o una regola|FB-5|L6"
)
if ! skip_if_done 3; then
  say "Parti dalla riga che descrive il tuo fallimento ($(get F_DID))."
  i=1
  for p in "${PIECES[@]}"; do
    IFS='|' read -r who what ids lvl <<<"$p"
    printf '  %s%s%s  se l'"'"'agente %s\n       → %s %s(%s · %s)%s\n' "$BOLD" "$i" "$RESET" "$who" "$what" "$DIM" "$ids" "$lvl" "$RESET"
    i=$((i + 1))
  done
  ask_req PIECE "Numero del pezzo:" '^[1-8]$' "Un numero da 1 a 8."
  write_env PIECE "$PIECE" >/dev/null
  IFS='|' read -r who what ids lvl <<<"${PIECES[$((PIECE - 1))]}"
  ask_req WHY "Perché questo pezzo elimina il tuo fallimento? (una riga)"
  write_env WHY "$WHY" >/dev/null
  hp body "$PLAN" "Il pezzo" "- Pezzo: $what
- Checklist: $ids · Livello: $lvl
- Perché: $WHY"
  hp cell "$PLAN" "Il mio piano" "Fallimento" "$(get F_DID)"
  hp cell "$PLAN" "Il mio piano" "Pezzo scritto oggi" "$what"
  ok "pezzo scritto in $PLAN"
  case "$PIECE" in
    4) src=".harness/tasks/T-NNN.md"; dst=".harness/tasks/T-001.md" ;;
    7) src=".harness/memory/progress.md"; dst="$src" ;;
    8) src=".harness/memory/lessons.md"; dst="$src" ;;
    *) src="" ;;
  esac
  if [[ -n "$src" ]]; then
    say "Il tuo pezzo è un file del kit: ${BOLD}$dst${RESET}."
    if [[ -f "$dst" ]]; then ok "$dst c'è già"; else mkdir -p "$(dirname "$dst")" && cp "$KIT/$src" "$dst" && ok "copiato $dst"; fi
    [[ "$PIECE" == 4 ]] && note "Lascia status: draft finché non l'hai riletto tu: il pre-hook lo applicherà più avanti (sezione 5)."
    [[ "$PIECE" == 7 ]] && note "Nella tappa di AGENTS.md metti in Topology: «a inizio sessione leggi .harness/memory/progress.md»."
    [[ "$PIECE" == 8 ]] && note "La Lesson produce un Pitfall: lo scrivi nella prossima tappa, in AGENTS.md → Pitfalls."
    edit "$dst" "compilalo a partire dal tuo fallimento."
  fi
  commit "harness: piano del porting (fallimento e pezzo)" "$PLAN" .harness
  done_stage 3
fi
note "Prossime tappe: 3.1 AGENTS.md · 3.2 contract · 3.3 guardrail. Il tuo pezzo: $(suggested 4 && echo -n '3.1 ')$(suggested 5 && echo -n '3.2 ')$(suggested 6 && echo -n '3.3')"
pause "Invio per AGENTS.md."

# ── 4 ── 3.1: AGENTS.md minimo ──────────────────────────────────────────────
stage "3.1 · AGENTS.md minimo (6')"
if ! skip_if_done 4 && optional_gate 4; then
  G="$(guide_file)"
  KEEP_INDEX=0; suggested 5 && KEEP_INDEX=1; [[ "$(get PIECE)" == 4 ]] && KEEP_INDEX=1
  if [[ "$BOOST" == 1 ]]; then
    if [[ -f "$G" ]]; then ok "$G c'è già"; else
      hp kit-agents "$KIT/AGENTS.md" "$G" guideline "$KEEP_INDEX" "$TESTER" "$HAS_PINT" "$HAS_PHPSTAN" "$LARAVEL_MAJOR"
      ok "creato $G dal kit (da ## Topology in giù), con i comandi di questo progetto"
    fi
  elif [[ -f AGENTS.md ]]; then
    added="$(hp agents-merge "$KIT/AGENTS.md" AGENTS.md)"
    [[ -z "$added" ]] && ok "AGENTS.md ha già le 5 sezioni" || ok "aggiunte in fondo ad AGENTS.md le sezioni: $(echo "$added" | tr '\n' ' ')"
  else
    hp kit-agents "$KIT/AGENTS.md" AGENTS.md agents "$KEEP_INDEX" "$TESTER" "$HAS_PINT" "$HAS_PHPSTAN" "$LARAVEL_MAJOR"
    ok "copiato AGENTS.md dal kit, con i comandi di questo progetto"
  fi
  say "Compila ${BOLD}solo${RESET} tre sezioni:"
  step "Commands: controlla i comandi che ho scritto; aggiungi quelli che definiscono «fatto»."
  step "Conflicts: da una a tre righe, a partire dal fallimento ($(get F_DID))."
  step "Pitfalls: una riga, in positivo («fai X»), legata al fallimento."
  note "Topology ed Environment possono restare vuote (le intestazioni restano). Togli le righe d'esempio che non valgono qui."
  while :; do
    edit "$G" "compila Commands, Conflicts e Pitfalls."
    if problems="$(hp check-agents "$G")"; then ok "$G: 5 sezioni, Conflicts e Pitfalls compilate"; break; fi
    printf '%s\n' "$problems" | while IFS= read -r p; do warn "$p"; done
    confirm "Lo riapro?" || break
  done
  REGEN_OK=1
  if [[ "$BOOST" == 1 ]]; then
    boost_regen || REGEN_OK=0
  elif [[ "$AGENT" != x ]]; then
    if [[ ! -f CLAUDE.md ]]; then
      printf '@AGENTS.md\n' > CLAUDE.md && ok "creato CLAUDE.md con la sola riga @AGENTS.md"
    elif ! hp contains CLAUDE.md "@AGENTS.md"; then
      warn "CLAUDE.md non importa AGENTS.md: due fonti di istruzioni che divergeranno."
      step "Sposta in AGENTS.md ciò che serve; in CLAUDE.md resta @AGENTS.md più le note solo per Claude."
      confirm "Aggiungo @AGENTS.md in cima a CLAUDE.md?" && hp claude-import CLAUDE.md && ok "CLAUDE.md importa AGENTS.md"
    fi
  fi
  if ((REGEN_OK)); then
    commit "harness: AGENTS.md minimo (Commands, Conflicts, Pitfalls)" AGENTS.md CLAUDE.md boost.json .ai "$PLAN"
    say ""
    say "${BOLD}Fatto quando:${RESET} apri una sessione ${BOLD}nuova${RESET} dell'agente e chiedi:"
    say "  «dove si decide <la cosa del tuo fallimento>?»"
    if confirm "L'agente ha risposto citando la tua riga di Conflicts?"; then ok "3.1 fatto"; done_stage 4
    else warn "Rendi la riga più precisa (il path fra backtick, cosa usare al suo posto) e rilancia il wizard."; fi
  else
    commit "harness: sezioni di AGENTS.md in $G (AGENTS.md non ancora rigenerato)" .ai "$PLAN"
    warn "3.1 non è fatto: AGENTS.md non contiene le tue sezioni. Sistema Boost e rilancia il wizard."
  fi
fi
pause "Invio per il contract."

# ── 5 ── 3.2: Behavioral Contract con un test che morde ─────────────────────
stage "3.2 · Un Behavioral Contract con un test che morde (7')"
if ! skip_if_done 5 && optional_gate 5; then
  ask_req OP_SLUG  "Nome del file del contract (es. orders.cancel):" '^[a-z0-9]+([._-][a-z0-9]+)*$' "Minuscole, numeri, punti o trattini."
  ask_req OP_TITLE "Nome dell'operazione (es. Annulla ordine):"
  ask_def OP_DESC  "Cosa fa, in una frase:" ""
  ask_req PREFIX   "Prefisso degli ID (es. CANCEL → CANCEL-INV-1):" '^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$' "Maiuscole, numeri e trattini (CANCEL, ORDER-PAY)."
  while :; do
    ask_req CLASSES "File della classe che la implementa (uno o più, separati da spazio):"
    bad=""; for c in $CLASSES; do [[ -f "$c" && "$c" == *.php ]] || bad="$bad $c"; done
    [[ -z "$bad" ]] && break
    warn "Non trovo:$bad (path relativo alla root, es. app/Actions/Orders/CancelOrder.php)"
    write_env CLASSES "" >/dev/null
  done
  say "Da 1 a 3 invarianti: regole sempre vere, ognuna con il suo test. Invio a vuoto per fermarti."
  ask_req INV_1 "$PREFIX-INV-1:"
  ask INV_2 "$PREFIX-INV-2 (facoltativa):"; INV_2="${INV_2%$'\r'}"
  INV_3=""; [[ -n "$INV_2" ]] && { ask INV_3 "$PREFIX-INV-3 (facoltativa):"; INV_3="${INV_3%$'\r'}"; }
  for k in OP_SLUG OP_TITLE OP_DESC PREFIX CLASSES INV_1 INV_2 INV_3; do write_env "$k" "${!k}" >/dev/null; done
  N=1; [[ -n "$INV_2" ]] && N=2; [[ -n "$INV_3" ]] && N=3
  C="docs/contracts/$OP_SLUG.md"
  r="$(hp contract "$KIT/docs/contracts/_template.md" "$C" "$OP_TITLE" "$OP_DESC" "$OP_SLUG" "$CLASSES" "$PREFIX" "$INV_1" "$INV_2" "$INV_3")"
  ok "$C $r: invarianti $PREFIX-INV-1..$N"
  hp index "$KIT/docs/contracts/INDEX.md" docs/contracts/INDEX.md "$OP_TITLE" "$OP_SLUG" "$CLASSES" "$PREFIX-INV-1..$N"
  ok "docs/contracts/INDEX.md: riga per $OP_SLUG.md"
  for c in $CLASSES; do ok "$c: @contract $(hp tag "$c" "$OP_SLUG")"; done
  edit "$C" "scrivi i Non-goals: cosa l'operazione NON fa, soprattutto ciò che un agente aggiungerebbe «per completezza». Il resto può aspettare."

  ask_req TEST_INV "Quale invariante è più vicina al fallimento? (il numero)" "^[1-$N]$" "Un numero da 1 a $N."
  ID="$PREFIX-INV-$TEST_INV"
  RULE_VAR="INV_$TEST_INV"; RULE="${!RULE_VAR}"
  STUDLY="$(printf '%s' "$OP_SLUG" | php -r 'echo str_replace(" ", "", ucwords(preg_replace("/[._-]+/", " ", trim(fgets(STDIN)))));')"
  ask_def TEST_FILE "File del test:" "tests/Feature/Contracts/${STUDLY}Test.php"
  write_env TEST_INV "$TEST_INV" >/dev/null; write_env TEST_FILE "$TEST_FILE" >/dev/null
  ok "$TEST_FILE: test $(hp test "$TESTER" "$PHPUNIT_MAJOR" "$TEST_FILE" "$ID" "$RULE") nel group $ID"
  note "Il corpo lancia «Da scrivere: $ID»: finché resta lì, il test è rosso per il motivo sbagliato."
  while :; do
    edit "$TEST_FILE" "scrivi il test di $ID ($RULE), al posto della riga «Da scrivere»."
    tests "$ID"
    if hp contains "$TEST_FILE" "Da scrivere: $ID"; then
      warn "Il test di $ID non è ancora scritto: la riga «Da scrivere: $ID» è ancora nel file."
      confirm "Lo riapro?" && continue
      TEST_STATE="da scrivere"; break
    fi
    if ((RC == 0)); then TEST_STATE="verde"; else TEST_STATE="rosso"; fi
    say "Il test è ${BOLD}$TEST_STATE${RESET}."
    if [[ "$TEST_STATE" == rosso ]]; then
      note "Rosso va bene se documenta il fallimento: l'invariante oggi non è rispettata, e la correzione è il primo task di lunedì."
      confirm "È rosso per il motivo giusto (l'asserzione sull'invariante, non un errore di setup)?" && break
    else
      break
    fi
  done
  write_env TEST_STATE "$TEST_STATE" >/dev/null
  case "$TEST_STATE" in
    "da scrivere") MSG="harness: contract $OP_SLUG; test di $ID ancora da scrivere" ;;
    rosso)         MSG="harness: contract $OP_SLUG con test $ID (rosso: documenta il fallimento)" ;;
    *)             MSG="harness: contract $OP_SLUG con test $ID" ;;
  esac
  commit "$MSG" docs/contracts $CLASSES "$TEST_FILE"
  if [[ "$TEST_STATE" == verde ]]; then
    say ""
    say "${BOLD}Prova di sensibilità:${RESET} commenta la riga che garantisce $ID, salva, poi Invio."
    pause "Invio quando hai commentato la riga."
    tests "$ID"
    if ((RC != 0)); then ok "rosso senza la riga: il test morde"; done_stage 5
    else warn "Il test resta verde anche senza la riga: non sta provando $ID. Rivedilo."; fi
    changed="$(git status --porcelain -- app src 2>/dev/null | sed 's/^...//' | tr '\n' ' ')"; changed="${changed% }"
    if [[ -n "$changed" ]] && confirm "Ripristino con git checkout: $changed?"; then
      # shellcheck disable=SC2086
      git checkout -- $changed && ok "ripristinato"
    fi
  else
    [[ "$TEST_STATE" == rosso ]] && done_stage 5
  fi
fi
pause "Invio per il guardrail."

# ── 6 ── 3.3: un guardrail deterministico ───────────────────────────────────
stage "3.3 · Un guardrail deterministico (4')"
if ! skip_if_done 6 && optional_gate 6; then
  G="$(guide_file)"
  if [[ "$(get PIECE)" == 5 ]]; then
    if [[ "$AGENT" != x ]]; then
      DENY=("Read(./.env)" "Edit(./.env)" "Bash(php artisan migrate:fresh*)" "Bash(php artisan db:wipe*)")
      say "Claude Code, deny nativo in .claude/settings.json:"
      for d in "${DENY[@]}"; do step "$d"; done
      if confirm "Li aggiungo (le regole che ci sono già restano)?"; then
        n="$(hp deny .claude/settings.json "${DENY[@]}")"; ok ".claude/settings.json: $n regole nuove"
        git check-ignore -q .claude/settings.json && warn ".claude/settings.json è in .gitignore: il deny non arriverà al team."
      fi
      note "Il deny ferma il tool Read e cat .env, non php -r 'echo file_get_contents(\".env\");': per quello serve il pre-hook."
    fi
    if [[ "$AGENT" != c ]]; then
      warn "Codex: l'unica guardia verificata nel workshop è il pre-hook, che questo wizard non installa."
      note "Segui scheda-porting.md → 3.3 «Se ti serve il pre-hook» (quattro file, poi il blocco PreToolUse di .codex/hooks.json)."
      git check-ignore -q .codex/hooks.json && warn ".codex/ è in .gitignore: hooks.json non finirebbe nel commit."
    fi
    commit "harness: deny nativo su segreti e comandi distruttivi" .claude/settings.json
    say "${BOLD}Fatto quando:${RESET} in una sessione nuova chiedi «mostrami il contenuto di .env» e l'agente viene bloccato."
    confirm "Bloccato?" && done_stage 6
  else
    CMDS=()
    # @php: Composer usa il suo PHP e il proxy di vendor/bin, quindi funziona anche da cmd.exe su Windows.
    ((HAS_PINT)) && CMDS+=("@php vendor/bin/pint --test --dirty")
    ((HAS_PHPSTAN)) && CMDS+=("@php vendor/bin/phpstan analyse --no-progress")
    TB="@php vendor/bin/pest"; [[ "$TESTER" == phpunit ]] && TB="@php vendor/bin/phpunit"
    TS="$(get TEST_STATE)"; TID=""
    [[ -n "$(get PREFIX)" && -n "$(get TEST_INV)" ]] && TID="$(get PREFIX)-INV-$(get TEST_INV)"
    say "Il comando «fatto»: ${BOLD}composer harness:check${RESET}. Uno strumento che non hai non ci va."
    ((HAS_PHPSTAN)) || note "PHPStan non è installato: niente riga di PHPStan."
    if [[ -n "$TID" && "$TS" == verde ]]; then
      say "  [g] solo il group $TID (veloce)   [s] tutta la suite"
      ask_req SCOPE "Quali test?" '^[gsGS]$' "g oppure s."
      if [[ "$SCOPE" =~ ^[gG] ]]; then
        if [[ "$TESTER" == phpunit ]]; then CMDS+=("$TB --group $TID"); else CMDS+=("$TB --group=$TID"); fi
      else CMDS+=("$TB"); fi
    else
      CMDS+=("$TB")
      [[ "$TS" == rosso ]] && note "Il test di $TID è rosso apposta: harness:check resterà rosso finché lunedì non correggi il codice. È onesto: «fatto» non si può dire."
    fi
    say "composer.json → scripts.harness:check:"
    for c in "${CMDS[@]}"; do step "$c"; done
    r="$(hp script composer.json harness:check "${CMDS[@]}")"; ok "harness:check $r"
    hp commands-line "$G" "- Prima di dire \"fatto\": \`composer harness:check\`, deve essere verde."
    ok "$G → Commands: «Prima di dire fatto: composer harness:check»"
    [[ "$BOOST" == 1 ]] && { boost_regen || warn "La riga «Prima di dire fatto» è in $G, ma non ancora in AGENTS.md."; }
    RC=-1
    if confirm "Lancio composer harness:check adesso?$( [[ "${CMDS[*]}" == *--group* ]] || echo ' (lancia tutta la suite: con una suite lenta, di'"'"' no)')"; then
      run composer harness:check
      if [[ "$LAST_OUT" == *'Class "Phar" not found'* ]]; then
        warn "Il composer nel tuo PATH gira su un PHP senza Phar, e Pint si rompe: non è il progetto."
        note "Prova con un altro composer (which -a composer). L'agente userà lo stesso PATH: sistemalo, o scrivilo nei Pitfalls."
      fi
      if ((RC == 0)); then ok "harness:check verde"
      else warn "harness:check è rosso (exit $RC)$( [[ "$TS" == rosso ]] && echo ': atteso, per il test di '"$TID")."; fi
    else
      note "Lancialo tu prima di dire «fatto», dopo una modifica: pint --dirty guarda solo i file non committati."
    fi
    commit "harness: composer harness:check, citato in Commands" composer.json AGENTS.md CLAUDE.md boost.json .ai
    if ((RC == 0)) || [[ "$TS" == rosso ]] || ((RC == -1)); then done_stage 6; fi
  fi
fi
pause "Invio per il controllo della struttura."

# ── 7 ── controllo della struttura ──────────────────────────────────────────
stage "Controllo della struttura (verify-port)"
say "Guarda solo i collegamenti, in sola lettura. Il «fatto quando» di ogni passo resta a te."
if [[ "$PHP_OK_VERIFY" == 1 ]]; then
  run php "$W/takeaway/bin/verify-port" .
  if ((RC == 0)); then ok "struttura a posto$( [[ "$LAST_OUT" == *WARN* ]] && echo ' (con WARN: leggili)')"
  else warn "verify-port ha trovato un collegamento rotto: segui la freccia → sotto il FAIL, poi rilancia il wizard."; fi
else
  warn "verify-port vuole PHP 8.1 o successivo; quello nel PATH è più vecchio. Lancialo con un PHP recente:"
  note "php8.3 $W/takeaway/bin/verify-port ."
fi
pause "Invio per la review."

# ── 8 ── fase 4: review con i 5 criteri ─────────────────────────────────────
stage "Fase 4 · Review con i 5 criteri (3')"
if ! skip_if_done 8; then
  say "A coppie: racconta all'altro il fallimento e il pezzo. L'altro apre il diff:"
  step "git diff $BASE...$BRANCH"
  say "e applica i 5 criteri di $W/takeaway/criteri-verifica.md: per ognuno ✅, ❌ o «non dimostrato»."
  note "Da solo: una sessione NUOVA dell'agente, che non ha visto il lavoro, con questo prompt:"
  note "  «Rivedi git diff $BASE...$BRANCH con i 5 criteri di $W/takeaway/criteri-verifica.md (test,"
  note "   autorizzazione, idempotenza, transazioni, tracciabilità). Per ognuno un esito: ✅, ❌ o"
  note "   'non dimostrato', con l'evidenza. Non modificare niente.»"
  pause "Invio quando hai gli esiti."
  for crit in Test Autorizzazione Idempotenza Transazioni Tracciabilità; do
    key="R_$(printf '%s' "$crit" | tr -dc 'A-Za-z')"
    ask_req "$key" "$crit: [s] ✅  [n] ❌  [d] non dimostrato" '^[sndSND]$' "s, n oppure d."
    case "${!key}" in s|S) e="✅" ;; n|N) e="❌" ;; *) e="non dimostrato" ;; esac
    ask_def "${key}_EV" "  evidenza (una riga):" ""
    ev="${key}_EV"
    hp cell "$PLAN" "Review a coppie" "$crit" "$e" "${!ev}"
    write_env "$key" "${!key}" >/dev/null; write_env "${key}_EV" "${!ev}" >/dev/null
  done
  ok "review scritta in $PLAN"
  done_stage 8
fi
pause "Invio per lunedì."

# ── 9 ── fase 4: lunedì ─────────────────────────────────────────────────────
stage "Fase 4 · Lunedì (2')"
DEF_TASK=""
[[ "$(get TEST_STATE)" == rosso ]] && DEF_TASK="far rispettare $(get PREFIX)-INV-$(get TEST_INV) ($(get INV_$(get TEST_INV))), finché il suo test è verde"
ask_def PR_TO      "PR di $BRANCH assegnata a (chi la rivede):" ""
ask_def FIRST_TASK "Primo task reale con un Task Contract:" "$DEF_TASK"
ask_def NEXT_PIECE "Prossimo pezzo (solo se il fallimento si ripresenta):" ""
ask_def DECAY      "Data della revisione contro il decay:" "$(hp date 28)"
for k in PR_TO FIRST_TASK NEXT_PIECE DECAY; do write_env "$k" "${!k}" >/dev/null; done
hp checkline "$PLAN" "PR di \`harness/porting\` aperta e assegnata a:" "$PR_TO"
hp checkline "$PLAN" "Primo task reale con un Task Contract:" "$FIRST_TASK"
hp checkline "$PLAN" "Promemoria per le domande contro il decay, il:" "$DECAY"
hp cell "$PLAN" "Il mio piano" "Prossimo pezzo" "$NEXT_PIECE"
hp cell "$PLAN" "Il mio piano" "Data della revisione" "$DECAY"
DONE_STEPS=""
[[ "$(get DONE_4)" == 1 ]] && DONE_STEPS="$DONE_STEPS AGENTS.md (Conflicts, Pitfalls);"
[[ -n "$(get OP_SLUG)" ]] && DONE_STEPS="$DONE_STEPS contract $(get OP_SLUG) con test $(get PREFIX)-INV-$(get TEST_INV) ($(get TEST_STATE));"
[[ "$(get DONE_6)" == 1 ]] && DONE_STEPS="$DONE_STEPS $( [[ "$(get PIECE)" == 5 ]] && echo deny nativo || echo composer harness:check);"
[[ -n "$DONE_STEPS" ]] && hp cell "$PLAN" "Il mio piano" "Pezzo scritto oggi" "$(printf '%s' "${DONE_STEPS# }" | sed 's/;$//')"
commit "harness: piano per lunedì" "$PLAN"
say ""
say "Da non fare lunedì: copiare tutta .harness/ del workshop, un contract per ogni operazione, un hook"
say "per un fallimento che non hai ancora visto. Ogni pezzo risponde a «quale fallimento previene?»."
say ""
step "Pubblica il branch e apri la PR: git push -u origin $BRANCH"
